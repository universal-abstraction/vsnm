#!/bin/bash
#
# vsnm - A minimal, keyboard-driven note manager
# https://github.com/universal-abstraction/vsnm
#
# Usage: vsnm [options]
#
# Options:
#   -h, --help     Show this help message
#   --config       Print config file location
#   -v, --version  Show version information
#

set -euo pipefail

# ============================================================================
# SECTION 1: XDG PATHS & DIRECTORIES
# ============================================================================

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/vsnm"
CONFIG_FILE="$CONFIG_DIR/config"
USER_TEMPLATES_DIR="$CONFIG_DIR/templates"

# Installed data (default config and templates). Searched in XDG_DATA_HOME
# first, then XDG_DATA_DIRS, so both "make install" and
# "make install PREFIX=/usr/local" work.
find_data_dir() {
    local dir
    local IFS=:
    for dir in "${XDG_DATA_HOME:-$HOME/.local/share}" \
               ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
        if [[ -f "$dir/vsnm/defaults/config" ]]; then
            echo "$dir/vsnm"
            return 0
        fi
    done
    return 1
}

DATA_DIR="$(find_data_dir || true)"
TEMPLATES_DIR="$DATA_DIR/templates"
DEFAULTS_DIR="$DATA_DIR/defaults"

# ============================================================================
# SECTION 2: DEFAULT CONFIGURATION
# ============================================================================

# Default values (can be overridden in config file)
: "${NOTES_DIR:=$HOME/notes}"
: "${EDITOR:=nvim}"
: "${TERMINAL:=kitty}"
: "${DATE_FORMAT:=%d-%m-%Y}"
: "${MENU_LAUNCHER:=wofi}"

# Daily notes defaults
: "${DAILY_TEMPLATE:=daily}"

# Recent notes list defaults
: "${RECENT_LIST_ENABLED:=true}"
: "${RECENT_LIST_COUNT:=10}"
: "${RECENT_LIST_INCLUDE_CUSTOM:=false}"
: "${RECENT_LIST_INCLUDE_TODAY:=false}"
: "${RECENT_LIST_SORT:=date_modified_desc}"

# Custom notes defaults
: "${CUSTOM_NOTES_ENABLED:=true}"
: "${CUSTOM_NOTES_DATE_PREFIX:=true}"
: "${CUSTOM_NOTES_TEMPLATE:=custom}"

# How many days back Rewind looks for the previous daily note
REWIND_MAX_DAYS=366

# ============================================================================
# SECTION 3: INITIALIZATION & CONFIG LOADING
# ============================================================================

# Initialize configuration directory structure
init_config() {
    if [[ -z "$DATA_DIR" ]]; then
        echo "Error: vsnm data files not found" >&2
        echo "Run 'make install' to install vsnm properly" >&2
        exit 1
    fi

    mkdir -p "$CONFIG_DIR"

    # Copy default config if it doesn't exist
    if [[ ! -f "$CONFIG_FILE" ]]; then
        cp "$DEFAULTS_DIR/config" "$CONFIG_FILE"
    fi
}

# Load user configuration
load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck source=/dev/null
        source "$CONFIG_FILE"
    fi
}

# ============================================================================
# SECTION 4: CORE FUNCTIONS
# ============================================================================

# --- Date helpers ---

get_today() {
    date +"$DATE_FORMAT"
}

get_tomorrow() {
    date -d tomorrow +"$DATE_FORMAT"
}

get_days_ago() {
    date -d "$1 days ago" +"$DATE_FORMAT"
}

# Regex that matches a note name produced by DATE_FORMAT. Common numeric
# specifiers get exact patterns; any other specifier matches a run of
# characters without "_" (the separator used by date-prefixed custom notes).
date_format_regex() {
    local fmt="$DATE_FORMAT" re="" c i
    for ((i = 0; i < ${#fmt}; i++)); do
        c="${fmt:i:1}"
        if [[ "$c" == "%" && $((i + 1)) -lt ${#fmt} ]]; then
            i=$((i + 1))
            case "${fmt:i:1}" in
                Y) re+='[0-9]{4}' ;;
                y|m|d|H|M|S) re+='[0-9]{2}' ;;
                j) re+='[0-9]{3}' ;;
                F) re+='[0-9]{4}-[0-9]{2}-[0-9]{2}' ;;
                %) re+='%' ;;
                *) re+='[^_]+' ;;
            esac
        else
            case "$c" in
                '.'|'^'|'$'|'*'|'+'|'?'|'('|')'|'['|']'|'{'|'}'|'|'|'\')
                    re+="\\$c" ;;
                *)
                    re+="$c" ;;
            esac
        fi
    done
    echo "^${re}\$"
}

# --- Path helpers ---

get_note_path() {
    local date="$1"
    echo "$NOTES_DIR/$date.md"
}

# --- Note listing ---

DAILY_NOTE_REGEX=""

# Check if a note name is a daily note (matches DATE_FORMAT)
is_daily_note() {
    local name="$1"
    [[ -n "$DAILY_NOTE_REGEX" ]] || DAILY_NOTE_REGEX="$(date_format_regex)"
    [[ "$name" =~ $DAILY_NOTE_REGEX ]]
}

# Prefix each note name with a stat field, sort numerically, strip the field.
# $1 = stat format, $2 = sort flags
sort_by_stat() {
    local format="$1" flags="$2" name file value
    while IFS= read -r name; do
        file="$NOTES_DIR/$name.md"
        [[ -f "$file" ]] || continue
        value="$(stat -c "$format" "$file")"
        # Birth time is 0 when the filesystem doesn't record it; use ctime
        if [[ "$format" == "%W" && ( "$value" == "0" || -z "$value" ) ]]; then
            value="$(stat -c %Z "$file")"
        fi
        echo "$value $name"
    done | sort "$flags" | cut -d' ' -f2-
}

# Sort notes based on RECENT_LIST_SORT setting
sort_notes() {
    case "$RECENT_LIST_SORT" in
        date_modified_asc)  sort_by_stat %Y -n ;;
        date_created_desc)  sort_by_stat %W -rn ;;
        date_created_asc)   sort_by_stat %W -n ;;
        name_asc)           sort ;;
        name_desc)          sort -r ;;
        *)                  sort_by_stat %Y -rn ;;
    esac
}

get_recent_notes() {
    local today tomorrow name
    today=$(get_today)
    tomorrow=$(get_tomorrow)

    find "$NOTES_DIR" -maxdepth 1 -name "*.md" -type f -printf '%f\n' 2>/dev/null |
        sed 's|\.md$||' |
        while IFS= read -r name; do
            if [[ "$RECENT_LIST_INCLUDE_TODAY" != "true" ]]; then
                case "$name" in
                    "$today"|"$tomorrow"|"${today}_"*|"${tomorrow}_"*) continue ;;
                esac
            fi
            if [[ "$RECENT_LIST_INCLUDE_CUSTOM" != "true" ]] && ! is_daily_note "$name"; then
                continue
            fi
            echo "$name"
        done |
        sort_notes |
        head -n "$RECENT_LIST_COUNT"
}

# Most recent daily note before today, looking back up to REWIND_MAX_DAYS
get_last_note() {
    local i date
    for ((i = 1; i <= REWIND_MAX_DAYS; i++)); do
        date=$(get_days_ago "$i")
        if [[ -f "$(get_note_path "$date")" ]]; then
            echo "$date"
            return 0
        fi
    done
}

# --- Template system ---

# Escape a string for use as the replacement in sed s/// (delimiter "/")
sed_escape() {
    printf '%s' "$1" | sed 's/[\/&]/\\&/g'
}

# Find a template by name: user templates first, then installed ones
find_template() {
    local name="$1"
    local candidate
    for candidate in "$USER_TEMPLATES_DIR/$name.md" "$TEMPLATES_DIR/$name.md"; do
        if [[ -f "$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    done
    echo "Error: template '$name' not found in $USER_TEMPLATES_DIR or $TEMPLATES_DIR" >&2
    notify "Template not found: $name"
    exit 1
}

# Render a template into a file, replacing {{DATE}} and {{TITLE}}
# $1 = template name, $2 = date, $3 = title, $4 = output file
render_template() {
    local template_file date title output_file
    template_file="$(find_template "$1")"
    date="$(sed_escape "$2")"
    title="$(sed_escape "$3")"
    output_file="$4"

    sed -e "s/{{DATE}}/$date/g" -e "s/{{TITLE}}/$title/g" "$template_file" > "$output_file"
}

# --- Note operations ---

create_note() {
    local date="$1"
    local note_path
    note_path=$(get_note_path "$date")

    # Don't overwrite existing notes
    if [[ -f "$note_path" ]]; then
        return 0
    fi

    render_template "$DAILY_TEMPLATE" "$date" "$date" "$note_path"
}

rewind_note() {
    local today last_note today_path last_note_path
    today=$(get_today)
    today_path=$(get_note_path "$today")

    # Check if today's note already exists
    if [[ -f "$today_path" ]]; then
        notify "Today's note already exists"
        echo "$today_path"
        return 0
    fi

    last_note=$(get_last_note)

    if [[ -z "$last_note" ]]; then
        notify "No previous daily note found"
        create_note "$today"
        echo "$today_path"
        return 0
    fi

    last_note_path=$(get_note_path "$last_note")

    if declare -f rewind_hook &>/dev/null; then
        # The hook's stdout must not leak into the returned path
        rewind_hook "$last_note_path" "$today_path" >&2
    else
        # Default rewind: copy the note and update the date in its first line
        sed "1s/$(sed_escape "$last_note")/$(sed_escape "$today")/" \
            "$last_note_path" > "$today_path"
    fi

    echo "$today_path"
}

open_note() {
    local note_path="$1"

    mkdir -p "$NOTES_DIR"

    # TERMINAL and EDITOR are unquoted on purpose so they can carry flags
    # shellcheck disable=SC2086
    $TERMINAL $EDITOR "$note_path" &
}

browse_notes() {
    mkdir -p "$NOTES_DIR"
    # shellcheck disable=SC2086,SC2016
    $TERMINAL sh -c 'cd "$1" && ls -1t -- *.md 2>/dev/null | sed "s|\.md$||"; exec "${SHELL:-sh}"' \
        sh "$NOTES_DIR" &
}

# --- Filename helpers ---

# Normalize a note name: lowercase, spaces to dashes, keep only letters
# (any script), digits and dashes
normalize_filename() {
    local input="${1,,}"
    echo "$input" | tr ' ' '-' | sed 's/[^[:alnum:]-]//g; s/--*/-/g; s/^-//; s/-$//'
}

# --- Custom note operations ---

# Create custom note with user-provided name
create_custom_note() {
    local note_name
    note_name=$(prompt_input "Note name")

    # Exit if user cancelled
    [[ -z "$note_name" ]] && return 0

    local normalized
    normalized=$(normalize_filename "$note_name")

    if [[ -z "$normalized" ]]; then
        notify "Invalid note name"
        return 1
    fi

    local today filename
    today=$(get_today)
    if [[ "$CUSTOM_NOTES_DATE_PREFIX" == "true" ]]; then
        filename="${today}_${normalized}.md"
    else
        filename="${normalized}.md"
    fi
    local note_path="$NOTES_DIR/$filename"

    if [[ -f "$note_path" ]]; then
        notify "Note already exists: $filename"
        open_note "$note_path"
        return 0
    fi

    render_template "$CUSTOM_NOTES_TEMPLATE" "$today" "$note_name" "$note_path"

    open_note "$note_path"
}

# --- Notifications ---

notify() {
    local message="$1"
    if command -v notify-send &>/dev/null; then
        notify-send "vsnm" "$message"
    else
        echo "[vsnm] $message" >&2
    fi
}

# ============================================================================
# SECTION 5: MENU & UI
# ============================================================================

# Menu icons
ICON_TODAY="📝"
ICON_TOMORROW="📅"
ICON_REWIND="🔄"
ICON_NEW="✨"
ICON_NOTE="📄"
ICON_BROWSE="📂"

MENU_TODAY="$ICON_TODAY Today"
MENU_TOMORROW="$ICON_TOMORROW Tomorrow"
MENU_REWIND="$ICON_REWIND Rewind"
MENU_NEW="$ICON_NEW New Note"
MENU_BROWSE="$ICON_BROWSE Browse Notes"

build_menu() {
    local today tomorrow
    today=$(get_today)
    tomorrow=$(get_tomorrow)

    echo "$MENU_TODAY ($today)"
    echo "$MENU_TOMORROW ($tomorrow)"
    echo "$MENU_REWIND"

    if [[ "$CUSTOM_NOTES_ENABLED" == "true" ]]; then
        echo "$MENU_NEW"
    fi

    if [[ "$RECENT_LIST_ENABLED" == "true" ]]; then
        local recent
        recent=$(get_recent_notes) || true
        if [[ -n "$recent" ]]; then
            while IFS= read -r note; do
                echo "$ICON_NOTE $note"
            done <<< "$recent"
        fi
    fi

    echo "$MENU_BROWSE"
}

check_launcher() {
    case "$MENU_LAUNCHER" in
        wofi|rofi|dmenu|fzf) ;;
        *)
            echo "Unknown menu launcher: $MENU_LAUNCHER" >&2
            echo "Supported: wofi, rofi, dmenu, fzf" >&2
            exit 1
            ;;
    esac
}

show_menu() {
    case "$MENU_LAUNCHER" in
        wofi)
            wofi --dmenu --prompt "Notes" --cache-file=/dev/null
            ;;
        rofi)
            rofi -dmenu -p "Notes"
            ;;
        dmenu)
            dmenu -p "Notes"
            ;;
        fzf)
            fzf --prompt="Notes> " --height=40%
            ;;
    esac
}

# Prompt user for text input
prompt_input() {
    local prompt_text="$1"
    local input

    case "$MENU_LAUNCHER" in
        wofi)
            echo "" | wofi --dmenu \
                --prompt "$prompt_text" \
                --cache-file=/dev/null \
                --lines 0
            ;;
        rofi)
            echo "" | rofi -dmenu -p "$prompt_text" -l 0
            ;;
        dmenu)
            echo "" | dmenu -p "$prompt_text"
            ;;
        *)
            read -r -p "$prompt_text: " input
            echo "$input"
            ;;
    esac
}

handle_selection() {
    local selection="$1"
    local note_path

    case "$selection" in
        "$MENU_TODAY"*)
            local today
            today=$(get_today)
            note_path=$(get_note_path "$today")
            create_note "$today"
            open_note "$note_path"
            ;;

        "$MENU_TOMORROW"*)
            local tomorrow
            tomorrow=$(get_tomorrow)
            note_path=$(get_note_path "$tomorrow")
            create_note "$tomorrow"
            open_note "$note_path"
            ;;

        "$MENU_REWIND")
            note_path=$(rewind_note)
            open_note "$note_path"
            ;;

        "$MENU_NEW")
            create_custom_note
            ;;

        "$MENU_BROWSE")
            browse_notes
            ;;

        *)
            # "📄 note-name" -> "note-name" (daily or custom note)
            local note_name="${selection#"$ICON_NOTE "}"
            note_path="$NOTES_DIR/$note_name.md"

            if [[ -f "$note_path" ]]; then
                open_note "$note_path"
            else
                notify "Note not found: $note_name"
                exit 1
            fi
            ;;
    esac
}

# ============================================================================
# SECTION 6: COMMAND LINE INTERFACE
# ============================================================================

show_help() {
    cat << 'EOF'
vsnm - A minimal, keyboard-driven note manager

USAGE:
    vsnm [OPTIONS]

OPTIONS:
    -h, --help     Show this help message
    --config       Print config file location
    -v, --version  Show version information

CONFIGURATION:
    Config file: ~/.config/vsnm/config
    Templates:   ~/.config/vsnm/templates/ (overrides the installed ones)

    The config file is created on first run.

KEYBINDING EXAMPLES:
    Hyprland:  bind = SUPER, N, exec, vsnm
    Sway:      bindsym $mod+n exec vsnm
    i3:        bindsym $mod+n exec --no-startup-id vsnm

MORE INFO:
    https://github.com/universal-abstraction/vsnm
EOF
}

# ============================================================================
# SECTION 7: MAIN ENTRY POINT
# ============================================================================

main() {
    case "${1:-}" in
        --help|-h)
            show_help
            exit 0
            ;;
        --config)
            echo "$CONFIG_FILE"
            exit 0
            ;;
        --version|-v)
            echo "vsnm 0.1.0"
            exit 0
            ;;
        -*)
            echo "Unknown option: $1" >&2
            echo "Use --help for usage information" >&2
            exit 1
            ;;
    esac

    init_config
    load_config
    check_launcher

    mkdir -p "$NOTES_DIR"

    # A cancelled menu exits non-zero; treat it as an empty selection.
    local selection
    selection=$(build_menu | show_menu) || true

    [[ -z "$selection" ]] && exit 0

    handle_selection "$selection"
}

main "$@"
